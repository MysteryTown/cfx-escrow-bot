# Discord Bot Configuration
DISCORD_TOKEN=your_discord_bot_token_here
DISCORD_CLIENT_ID=your_discord_application_client_id

# Optional: Guild ID for faster command registration (during development)
# Remove or leave empty for global commands
DISCORD_GUILD_ID=your_server_id_here

# CFX Forum Cookie
# 1. Go to https://forum.cfx.re and log in
# 2. Open DevTools (F12) > Application > Cookies
# 3. Find the "_t" cookie and copy its value
CFX_FORUM_COOKIE=your_forum_t_cookie_value

# Optional: Restrict usage to specific roles (comma-separated role IDs)
# Leave empty to allow all users
ALLOWED_ROLES=

# Optional: Restrict usage to specific channels (comma-separated channel IDs)
# Leave empty to allow all channels
ALLOWED_CHANNELS=
